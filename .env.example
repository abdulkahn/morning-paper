# Copy to .env.local and fill in. Never commit real values.
# Everything is optional while LLM_MODE=fixture (the default).

# live | fixture
LLM_MODE=fixture
DEMO_MODE=false

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
LLM_WRITER_MODEL=claude-opus-5-5
LLM_BULK_MODEL=claude-haiku-5-5

# Embeddings (https://www.voyageai.com)
VOYAGE_API_KEY=

# News (https://open-platform.theguardian.com)
GUARDIAN_API_KEY=

# Supabase (Project settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Shared secret for cron-triggered routes (min 16 chars)
CRON_SECRET=
